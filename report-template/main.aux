\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Thresholds on the standard deviation $\sigma _\theta $ of an elevation estimate as a function of its mean $\bar  {\theta }$, for the Ping360 ($b = 25^\circ $) and $k = 3$, computed from Eqs.~\eqref  {eq:msis_sigmal}--\eqref  {eq:msis_sigmaT}. Estimates below $\sigma _T = \min (\sigma _l, \sigma _m)$ (shaded) keep their beta distribution; the others are replaced by the uniform distribution. Fig.~9 of \citet  {breux2020elevation} shows the same thresholds, as variances, for a $35^\circ $ beam.}}{17}{figure.10}\protected@file@percent }
\newlabel{fig:msis_thresholds}{{10}{17}{Thresholds on the standard deviation $\sigma _\theta $ of an elevation estimate as a function of its mean $\bar {\theta }$, for the Ping360 ($b = 25^\circ $) and $k = 3$, computed from Eqs.~\eqref {eq:msis_sigmal}--\eqref {eq:msis_sigmaT}. Estimates below $\sigma _T = \min (\sigma _l, \sigma _m)$ (shaded) keep their beta distribution; the others are replaced by the uniform distribution. Fig.~9 of \citet {breux2020elevation} shows the same thresholds, as variances, for a $35^\circ $ beam}{figure.10}{}}
\newlabel{eq:msis_colour}{{59}{17}{Validity thresholds}{equation.4.59}{}}
\pgfsyspdfmark {pgfid77}{20492559}{2695619}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Uncertainty estimation for one echo of the horizontal sonar, over its whole vertical aperture $\theta \in [-b/2,\, b/2]$ ($b = 25^\circ \approx 0.44$~rad). \emph  {Top left:} likelihood $p(\rho ^v \mid \theta )$ of each candidate elevation angle, i.e.\ how well the 3D point given by $\theta $ falls on the surface estimated by the Gaussian process (Eq.~\eqref  {eq:msis_loglik}). It has a single local maximum, $\bar  {\theta } \approx -0.125$~rad (dashed blue line); for $\theta > -0.05$~rad the points fall far from the surface and the likelihood vanishes. \emph  {Bottom left:} inverse Fisher information $1/\mathcal  {I}(\theta )$, i.e.\ the variance $\sigma _\theta ^2$ an estimate would have at each $\theta $ (Eq.~\eqref  {eq:msis_sigmatheta}). It is small where the likelihood changes quickly with $\theta $ and grows without bound where the likelihood is flat (around $0.1$~rad). At $\bar  {\theta }$ it is about $0.0048$~rad$^2$, i.e.\ $\sigma _\theta \approx 0.07$~rad, just below the threshold $\sigma _T = \sigma _m \approx 0.073$~rad, so the estimate is kept. \emph  {Right:} resulting scaled beta distribution $p(\theta )$ of the estimate (Eq.~\eqref  {eq:def_beta}), with mean $\bar  {\theta }$ and variance $\sigma _\theta ^2$ ($\alpha \approx 1.2$, $\beta \approx 4.4$). Because $\bar  {\theta }$ is close to the lower edge of the beam and the distribution cannot extend beyond it, it is skewed: its peak ($\approx -0.19$~rad) lies closer to the edge than its mean.}}{18}{figure.11}\protected@file@percent }
\newlabel{fig:msis_uncertainty}{{11}{18}{Uncertainty estimation for one echo of the horizontal sonar, over its whole vertical aperture $\theta \in [-b/2,\, b/2]$ ($b = 25^\circ \approx 0.44$~rad). \emph {Top left:} likelihood $p(\rho ^v \mid \theta )$ of each candidate elevation angle, i.e.\ how well the 3D point given by $\theta $ falls on the surface estimated by the Gaussian process (Eq.~\eqref {eq:msis_loglik}). It has a single local maximum, $\bar {\theta } \approx -0.125$~rad (dashed blue line); for $\theta > -0.05$~rad the points fall far from the surface and the likelihood vanishes. \emph {Bottom left:} inverse Fisher information $1/\mathcal {I}(\theta )$, i.e.\ the variance $\sigma _\theta ^2$ an estimate would have at each $\theta $ (Eq.~\eqref {eq:msis_sigmatheta}). It is small where the likelihood changes quickly with $\theta $ and grows without bound where the likelihood is flat (around $0.1$~rad). At $\bar {\theta }$ it is about $0.0048$~rad$^2$, i.e.\ $\sigma _\theta \approx 0.07$~rad, just below the threshold $\sigma _T = \sigma _m \approx 0.073$~rad, so the estimate is kept. \emph {Right:} resulting scaled beta distribution $p(\theta )$ of the estimate (Eq.~\eqref {eq:def_beta}), with mean $\bar {\theta }$ and variance $\sigma _\theta ^2$ ($\alpha \approx 1.2$, $\beta \approx 4.4$). Because $\bar {\theta }$ is close to the lower edge of the beam and the distribution cannot extend beyond it, it is skewed: its peak ($\approx -0.19$~rad) lies closer to the edge than its mean}{figure.11}{}}
